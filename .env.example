# ─── RhymePilot AI configuration ────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env. Secrets are only read by the backend containers.

ENVIRONMENT=production
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-value
# Optional dedicated Fernet key for encrypting OAuth tokens / API keys at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Ports published on the host
FRONTEND_PORT=8080
API_PORT=8000
# Origins allowed to call the API directly (the bundled nginx proxies /api, so this is for dev/other hosts)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
FRONTEND_URL=http://localhost:8080

# PostgreSQL (used by docker compose to build DATABASE_URL)
POSTGRES_USER=rhymepilot
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=rhymepilot

# ─── AI models (configure one or more; keys can also be entered in Settings → AI models) ───
# Model names are NOT assumed: set the exact model id your account can use.
XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3

# ─── YouTube / Google Cloud ──────────────────────────────────────────────────────────────────
# API key (YouTube Data API v3) for public research. Optional if a channel is connected via OAuth.
YOUTUBE_API_KEY=
# OAuth 2.0 "Web application" client. Authorised redirect URI must match exactly:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/youtube/callback

# ─── Worker / media ──────────────────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=1
JOB_MAX_ATTEMPTS=3
MAX_MEDIA_FILE_MB=512
API_WORKERS=2
